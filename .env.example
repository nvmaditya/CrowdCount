# CrowdCount environment variables.
# Copy to .env and fill in what you need. .env is git-ignored: never commit real secrets.
# `crowdcount` reads ./.env on start (variables already set in your shell take precedence);
# docker compose passes it to the container.

# Password for the first admin account. Only used when no users exist yet.
# Leave empty to have a random one generated and printed once in the log.
CROWDCOUNT_ADMIN_PASSWORD=

# Secret for signing login tokens (use 32+ random characters, e.g. `openssl rand -base64 48`).
# Leave empty to generate one automatically and keep it in <data dir>/.jwt_secret.
CROWDCOUNT_JWT_SECRET=

# Where users, settings, the activity log and alert history are stored (default: ./data).
CROWDCOUNT_DATA_DIR=

# Where the demo video and model weights are downloaded (default: ~/.cache/crowdcount).
CROWDCOUNT_CACHE_DIR=

# Path to a config file (default: ./crowdcount.toml if it exists).
CROWDCOUNT_CONFIG=

# DEBUG, INFO, WARNING or ERROR (default: INFO).
CROWDCOUNT_LOG_LEVEL=

# Set to 1 only behind a reverse proxy you control, to log client IPs from X-Forwarded-For.
CROWDCOUNT_TRUST_PROXY=
